NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Free options: MongoDB Atlas (https://www.mongodb.com/atlas) shared cluster,
# or a local mongod (e.g. `docker run -p 27017:27017 mongo:7`).
MONGO_URI=mongodb://localhost:27017/bunk-manager

# Use a long, random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Firebase Cloud Messaging (push notifications). Generate a service account
# key from Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key. Leave unset in dev and the app still runs —
# pushes are logged to the console instead of sent (see src/services/fcmService.js).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key from the downloaded JSON exactly, keeping the \n escapes.
FIREBASE_PRIVATE_KEY=

# Set to "true" to disable the notification cron scheduler (e.g. when
# running multiple instances and only one should own scheduling).
DISABLE_NOTIFICATION_SCHEDULER=false

# Google Sign-In. Create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials — Authorized JavaScript
# origins must include both your frontend's URL and http://localhost:5173
# for local dev. Leave unset and the /auth/google endpoint clearly reports
# it's not configured, rather than silently failing.
GOOGLE_CLIENT_ID=

# Bunk AI (the in-app attendance assistant), via Google's free Gemini
# API. Create a key at https://aistudio.google.com/apikey (no billing
# required for the free tier) — leave unset and POST /api/ai/chat clearly
# reports it's not configured (503), rather than crashing. Never expose
# this to the frontend; it's only ever read here.
GEMINI_API_KEY=
